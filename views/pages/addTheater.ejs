<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Theater</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            background: #1f1f1f;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<body>

    <div class="form-card">
        <h2 class="mb-4 text-center">Add New Theater</h2>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>

                <form action="/add-theater" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Theater Name</label>
                        <input type="text" name="name" class="form-control" placeholder="Enter theater name" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" name="location" class="form-control" placeholder="e.g. Downtown, City Mall"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Total Seats</label>
                        <input type="number" name="theaterSeats" class="form-control" placeholder="e.g. 200" required>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-danger btn-lg">Add Theater</button>
                        <div class="d-flex gap-2">
                            <a href="/theaters" class="btn btn-outline-secondary w-50">View All</a>
                            <a href="/admin" class="btn btn-dark w-50">Admin Panel</a>
                        </div>
                    </div>
                </form>
    </div>

</body>

</html>