<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Movie</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            background: #1f1f1f;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<body>

    <div class="form-card">
        <h2 class="mb-4 text-center">Edit Movie</h2>

        <form action="/edit-movie/<%= movie._id %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Movie Title</label>
                <input type="text" name="title" class="form-control bg-dark text-white border-secondary"
                    value="<%= movie.title %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Release Year</label>
                <input type="number" name="year" class="form-control bg-dark text-white border-secondary"
                    value="<%= movie.year %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="desc" class="form-control bg-dark text-white border-secondary" rows="3"
                    required><%= movie.desc %></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Poster Image URL</label>
                <input type="url" name="image" class="form-control bg-dark text-white border-secondary"
                    value="<%= movie.image %>" required>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-danger btn-lg">Update Movie</button>
                <a href="/movies" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>

</body>

</html>