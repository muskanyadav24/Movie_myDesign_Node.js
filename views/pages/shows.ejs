<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shows</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
        }

        .show-card {
            background: #1f1f1f;
            border-radius: 8px;
            transition: transform 0.2s;
        }

        .show-card:hover {
            transform: translateY(-5px);
            background: #252525;
        }
    </style>
</head>

<body>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>📅 Upcoming Shows</h1>
            <div>
                        <a href="/home" class="btn btn-outline-light">Back to Home</a>
            </div>
        </div>

        <div class="row g-4">
            <% if (shows.length===0) { %>
                <div class="col-12 text-center py-5">
                    <h3 class="text-muted">No shows scheduled.</h3>
                </div>
                <% } else { %>

                    <% shows.forEach(show=> { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card bg-dark text-white rounded-4 shadow p-4 show-card h-100">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1 fw-bold text-danger">
                                            <%= show.movieId ? show.movieId.title : 'Unknown Movie' %>
                                        </h5>
                                        <small class="text-secondary">
                                            <%= show.theaterId ? show.theaterId.name : 'Unknown Theater' %>
                                                • <%= show.screenId ? show.screenId.name : 'Unknown Screen' %>
                                        </small>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="badge bg-secondary fs-6 px-3 py-2">
                                        <%= new Date(show.showTime).toLocaleString() %>
                                    </span>
                                    <span class="text-success fw-semibold small">
                                        <%= show.seats %> Seats
                                    </span>
                                </div>
                            </div>
                        </div>
                        <% }) %>

                            <% } %>
        </div>
    </div>

</body>

</html>