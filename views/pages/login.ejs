<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Login</title>
    <link rel="icon" href="../../images/icon-r.png">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(rgba(0, 0, 0, .75), rgba(0, 0, 0, .75)),
                url("../../images/bg.jpg") center/cover no-repeat;
            min-height: 100vh;
            color: #fff;
        }

        .logo {
            color: #e50914;
            font-size: 32px;
            font-weight: bold;
            padding: 25px 50px;
        }

        .login-box {
            background: rgba(0, 0, 0, 0.75);
            max-width: 450px;
            margin: 60px auto;
            padding: 60px;
            border-radius: 4px;
        }

        .login-box h2 {
            margin-bottom: 25px;
            font-weight: bold;
        }

        .form-control {
            background: #333;
            border: none;
            color: #fff;
            height: 50px;
            margin-bottom: 15px;
        }

        .form-control::placeholder {
            color: #b3b3b3;
        }

        .btn-red {
            background: #e50914;
            color: #fff;
            font-weight: bold;
            height: 50px;
        }

        .btn-red:hover {
            background: #b91c1c;
        }

        .small-text {
            color: #b3b3b3;
            font-size: 13px;
        }

        footer {
            background: rgba(0, 0, 0, .9);
            color: #757575;
            padding: 40px;
            font-size: 14px;
        }

        footer a {
            color: #757575;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <div class="logo">RealCinema</div>

    <!-- Login Box -->
    <div class="login-box">
        <h2>Login</h2>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
            <% } %>

                <form action="/login" method="post">
                    <input type="email" name="email" class="form-control" placeholder="Email or mobile number" required>
                    <input type="password" name="password" class="form-control" placeholder="Password" required>

                    <button class="btn btn-red w-100 mt-2" type="submit">Sign In</button>

                    <div class="d-flex justify-content-between mt-3 small-text">
                        <div>
                            <input type="checkbox"> Remember me
                        </div>
                        <a href="/forgot-password" class="small-text">Forgot password?</a>
                    </div>

                    <p class="mt-4 small-text">
                        New to RealCinema?
                        <a href="/register"
                            class="text-white text-decoration-none"> Sign up now.</a>
                    </p>

                    <p class="small-text">
                        This page is protected by Google reCAPTCHA to ensure you're not a bot.
                        <a href="#">Learn more.</a>
                    </p>
                </form>
    </div>

    <!-- Footer -->
    <!-- <footer>
        <div class="container">
            <p>Questions? Call 000-800-919-1743</p>

            <div class="row">
                <div class="col-md-3"><a href="#">FAQ</a></div>
                <div class="col-md-3"><a href="#">Help Centre</a></div>
                <div class="col-md-3"><a href="#">Terms of Use</a></div>
                <div class="col-md-3"><a href="#">Privacy</a></div>
            </div>
        </div>
    </footer> -->

</body>

</html>