<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Screens</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
        }

        .table-dark {
            --bs-table-bg: #1f1f1f;
            --bs-table-border-color: #333;
        }
    </style>
</head>

<body>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>🖥 Screens</h1>
            <div>
                <a href="/home" class="btn btn-outline-light">Back to Home</a>
            </div>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="p-3">Screen Name</th>
                            <th scope="col" class="p-3">Theater</th>
                            <th scope="col" class="p-3">Capacity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% screens.forEach(screen=> { %>
                            <tr>
                                <td class="p-3 align-middle fw-bold">
                                    <%= screen.name %>
                                </td>
                                <td class="p-3 align-middle text-secondary">
                                    <%= screen.theaterId ? screen.theaterId.name : 'Unknown Theater' %>
                                </td>
                                <td class="p-3 align-middle">
                                    <%= screen.seats %> Seats
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>

</html>