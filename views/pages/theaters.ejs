<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Theaters</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" href="../../images/icon-r.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
        }

        .table-dark {
            --bs-table-bg: #1f1f1f;
            --bs-table-border-color: #333;
        }
    </style>
</head>

<body>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>🏢 Theaters</h1>
            <div>
                <% if (userRole==='admin' ) { %>
                    <a href="/add-theater" class="btn btn-danger me-2">+ Add Theater</a>
                    <% } %>
                        <a href="/home" class="btn btn-outline-light">Back to Home</a>
            </div>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="p-3">Name</th>
                            <th scope="col" class="p-3">Location</th>
                            <th scope="col" class="p-3">Capacity</th>
                            <% if (userRole==='admin' ) { %>
                                <th scope="col" class="p-3">Actions</th>
                                <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% theaters.forEach(theater=> { %>
                            <tr>
                                <td class="p-3 align-middle fw-bold">
                                    <%= theater.name %>
                                </td>
                                <td class="p-3 align-middle">
                                    <%= theater.location %>
                                </td>
                                <td class="p-3 align-middle">
                                    <%= theater.theaterSeats %> Seats
                                </td>
                                <% if (userRole==='admin' ) { %>
                                    <td class="p-3 align-middle text-nowrap">
                                        <div class="d-flex gap-2">
                                            <a href="/edit-theater/<%= theater._id %>"
                                                class="btn btn-sm btn-outline-light">Edit</a>
                                            <form action="/delete-theater" method="POST"
                                                onsubmit="return confirm('Delete this theater?');">
                                                <input type="hidden" name="id" value="<%= theater._id %>">
                                                <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                    <% } %>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>

</html>