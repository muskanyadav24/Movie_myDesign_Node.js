<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Show</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            background: #1f1f1f;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<body>

    <div class="form-card">
        <h2 class="mb-4 text-center">Schedule New Show</h2>

        <form action="/add-show" method="POST">

            <div class="mb-3">
                <label class="form-label">Select Movie</label>
                <select name="movieId" class="form-select bg-dark text-white border-secondary" required>
                    <% movies.forEach(movie=> { %>
                        <option value="<%= movie._id %>">
                            <%= movie.title %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Select Theater</label>
                    <select name="theaterId" class="form-select bg-dark text-white border-secondary" required>
                        <% theaters.forEach(theater=> { %>
                            <option value="<%= theater._id %>">
                                <%= theater.name %> (<%= theater.location %>)
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Select Screen</label>
                    <select name="screenId" class="form-select bg-dark text-white border-secondary" required>
                        <% screens.forEach(screen=> { %>
                            <option value="<%= screen._id %>">
                                <%= screen.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Show Time</label>
                <input type="datetime-local" name="showTime" class="form-control bg-dark text-white border-secondary"
                    required>
            </div>

            <div class="mb-3">
                <label class="form-label">Available Seats</label>
                <input type="number" name="seats" class="form-control bg-dark text-white border-secondary" value="100"
                    required>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-danger btn-lg">Add Show</button>
                <div class="d-flex gap-2">
                    <a href="/shows" class="btn btn-outline-secondary w-50">View All</a>
                    <a href="/admin" class="btn btn-dark w-50">Admin Panel</a>
                </div>
            </div>
        </form>
    </div>

</body>

</html>