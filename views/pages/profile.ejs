<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - RealCinema</title>
    <link rel="icon" href="../../images/icon-r.png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Material Design Icons -->
    <link rel="stylesheet" href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css">
    <style>
        body {
            background-color: #141414;
            color: #fff;
        }

        /* Navbar */
        .navbar {
            background-color: #000;
        }

        .navbar-brand {
            color: #e50914 !important;
            font-weight: bold;
            font-size: 28px;
        }

        /* Sidebar styling */
        .page-body-wrapper {
            display: flex;
            flex-direction: row;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #212529;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }

        .sidebar .nav {
            display: flex;
            flex-direction: column;
        }

        .sidebar .nav-link {
            color: #9ca3af;
            padding: 12px 18px;
            border-radius: 8px;
            margin: 2px 10px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .sidebar .nav-link:hover {
            background-color: #1f2937;
            color: #ffffff;
        }

        .sidebar .nav-link.active {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: 600;
        }

        /* Profile Card */
        .profile-container {
            flex-grow: 1;
            padding: 40px;
        }

        .profile-card {
            background: #1f1f1f;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            margin: auto;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .profile-img {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #e50914;
            margin-bottom: 20px;
            box-shadow: 0 0 20px rgba(229, 9, 20, 0.3);
        }
        .profileHover:hover{
            background-color: #1f2937;
        }

        .label {
            color: #aaa;
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
            display: block;
        }

        .value {
            font-size: 1.1em;
            margin-bottom: 25px;
            border-bottom: 1px solid #333;
            padding-bottom: 10px;
            color: #fff;
        }

        .btn-edit {
            background-color: transparent;
            border: 1px solid #e50914;
            color: #e50914;
            transition: all 0.3s;
        }

        .btn-edit:hover {
            background-color: #e50914;
            color: #fff;
        }

        #edit-mode {
            display: none;
        }

        .form-control:focus {
            background-color: #2c2c2c;
            border-color: #e50914;
            box-shadow: none;
            color: #fff;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-4">
        <a href="/home" class="navbar-brand">RealCinema</a>

        <div class="ms-auto">
            <% if (user) { %>
                <div class="dropdown">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown"
                        data-bs-toggle="dropdown">
                        <img src="../../images/face11.jpg" class="rounded-circle me-2" width="40" height="40">
                        <span class="fw-semibold text-white">
                            <%= user.name %>
                        </span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow bg-black" >
                        <li><a class="dropdown-item profileHover text-white" href="/profile">👤 My Profile</a></li>
                        <li><a class="dropdown-item profileHover text-white" href="/changePassword">🔐 Change Password</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item profileHover text-danger" href="/logout">🚪 Logout</a></li>
                    </ul>
                </div>
                <% } %>
        </div>
    </nav>

    <div class="container-fluid page-body-wrapper p-0">
        <!-- Sidebar -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav pt-2">

                <!-- User Profile -->
                <li class="nav-item nav-profile">
                    <a href="#" class="nav-link d-flex align-items-center">
                        <div class="nav-profile-image">
                            <img src="../../images/face11.jpg" class="rounded-circle me-2" width="50" height="50">
                            <span class="login-status online"></span>
                        </div>
                        <div class="nav-profile-text d-flex flex-column">
                            <span class="font-weight-bold text-white">
                                <%= user.name %>
                            </span>
                            <span class="text-secondary text-small">Movie Fan</span>
                        </div>
                    </a>
                </li>

                <!-- Admin Panel Link -->
                <% if (user && user.role==='admin' ) { %>
                    <li class="nav-item mb-2">
                        <a class="nav-link bg-danger text-white rounded-3 shadow" href="/admin">
                            <span class="menu-title fw-bold">ADMIN DASHBOARD</span>
                        </a>
                    </li>
                    <hr class="border-secondary mx-3 mb-2">
                    <% } %>

                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link" href="/home">
                                <span class="menu-title">Dashboard</span>
                            </a>
                        </li>

                        <!-- Movies -->
                        <li class="nav-item">
                            <a class="nav-link" href="/movies">
                                <span class="menu-title">Movies</span>
                            </a>
                        </li>

                        <!-- Shows -->
                        <li class="nav-item">
                            <a class="nav-link" href="/shows">
                                <span class="menu-title">Shows</span>
                            </a>
                        </li>

                        <!-- Theaters -->
                        <li class="nav-item">
                            <a class="nav-link" href="/theaters">
                                <span class="menu-title">Theaters</span>
                            </a>
                        </li>

                        <!-- Screens -->
                        <li class="nav-item">
                            <a class="nav-link" href="/screens">
                                <span class="menu-title">Screens</span>
                            </a>
                        </li>

                        <!-- Tickets -->
                        <li class="nav-item">
                            <a class="nav-link" href="/my-bookings">
                                <span class="menu-title">My Tickets</span>
                            </a>
                        </li>

                        <!-- Reviews -->
                        <li class="nav-item">
                            <a class="nav-link" href="/reviews">
                                <span class="menu-title">Reviews</span>
                            </a>
                        </li>

                        <!-- Profile -->
                        <li class="nav-item">
                            <a class="nav-link" href="/profile">
                                <span class="menu-title">Profile</span>
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">
                                <span class="text-danger">Logout</span>
                            </a>
                        </li>

            </ul>

        </nav>

        <!-- Main Content -->
        <div class="profile-container">
            <div class="profile-card">
                <div class="text-center">
                    <img src="../../images/face11.jpg" alt="Profile" class="profile-img">
                    <h2 class="mb-4">User Profile</h2>
                </div>

                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <% if (typeof error !=='undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <!-- View Mode -->
                                <div id="view-mode">
                                    <div class="mb-4">
                                        <span class="label">Full Name</span>
                                        <div class="value">
                                            <%= user.name %>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <span class="label">Email Address</span>
                                        <div class="value">
                                            <%= user.email %>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <span class="label">Phone Number</span>
                                        <div class="value">
                                            <%= user.phone || 'Not provided' %>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <span class="label">Account Role</span>
                                        <div class="value" style="text-transform: capitalize;">
                                            <%= user.role %>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2 mt-4">
                                        <button type="button" id="enable-edit" class="btn btn-edit btn-lg">
                                            <i class="mdi mdi-pencil me-2"></i>Edit Profile
                                        </button>
                                    </div>
                                </div>

                                <!-- Edit Mode -->
                                <div id="edit-mode">
                                    <form action="/update-profile" method="POST">
                                        <div class="mb-3">
                                            <label class="label">Full Name</label>
                                            <input type="text" name="name"
                                                class="form-control bg-dark text-white border-secondary p-3"
                                                value="<%= user.name %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="label">Email Address</label>
                                            <input type="email" name="email"
                                                class="form-control bg-dark text-white border-secondary p-3"
                                                value="<%= user.email %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="label">Phone Number</label>
                                            <input type="tel" name="phone"
                                                class="form-control bg-dark text-white border-secondary p-3"
                                                value="<%= user.phone || '' %>" placeholder="Enter phone number">
                                        </div>

                                        <div class="row g-2 mt-4">
                                            <div class="col-8">
                                                <button type="submit" class="btn btn-danger btn-lg w-100">Save
                                                    Changes</button>
                                            </div>
                                            <div class="col-4">
                                                <button type="button" id="cancel-edit"
                                                    class="btn btn-outline-secondary btn-lg w-100">Cancel</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const viewMode = document.getElementById('view-mode');
        const editMode = document.getElementById('edit-mode');
        const enableEditBtn = document.getElementById('enable-edit');
        const cancelEditBtn = document.getElementById('cancel-edit');

        enableEditBtn.addEventListener('click', () => {
            viewMode.style.display = 'none';
            editMode.style.display = 'block';
        });

        cancelEditBtn.addEventListener('click', () => {
            editMode.style.display = 'none';
            viewMode.style.display = 'block';
        });
    </script>
</body>

</html>