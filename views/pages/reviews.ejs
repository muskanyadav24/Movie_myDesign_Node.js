<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Reviews</title>
    <link rel="icon" href="../../images/icon-r.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #141414;
            color: white;
        }

        .review-card {
            background: #1F1F1F;
            border-radius: 14px;
        }

        .rating {
            color: #ffc107;
            font-size: 18px;
        }

        /* DARK FORM INPUTS */
        .form-control,
        .form-select {
            background-color: #212529 !important;
            color: #ffffff !important;
            border: 1px solid #2c2c2c;
        }

        .form-control::placeholder {
            color: #9ca3af;
        }

        /* On focus */
        .form-control:focus,
        .form-select:focus {
            background-color: #212529;
            color: #ffffff;
            border-color: #e50914;
            box-shadow: none;
        }

        /* Dropdown options */
        .form-select option {
            background-color: #212529;
            color: #ffffff;
        }

        /* Textarea resize fix */
        textarea.form-control {
            resize: none;
        }
    </style>
</head>

<body>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>⭐ Movie Reviews</h1>
            <div>
                <a href="/home" class="btn btn-outline-light">Back to Home</a>
            </div>
        </div>

        <!-- ADD REVIEW FORM -->
        <div class="card review-card p-4 mb-5 text-white">
            <h5>Add Review</h5>

            <form action="/reviews" method="POST">
                <div class="mb-3">
                    <label class="form-label">Movie</label>
                    <select name="movieTitle" class="form-select" required>
                        <% movies.forEach(movie=> { %>
                            <option value="<%= movie.title %>">
                                <%= movie.title %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rating</label>
                    <select name="rating" class="form-select" required>
                        <option value="5">⭐⭐⭐⭐⭐</option>
                        <option value="4">⭐⭐⭐⭐</option>
                        <option value="3">⭐⭐⭐</option>
                        <option value="2">⭐⭐</option>
                        <option value="1">⭐</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Review</label>
                    <textarea name="comment" class="form-control" rows="3" required></textarea>
                </div>

                <button class="btn btn-danger">Submit Review</button>
            </form>
        </div>

        <!-- REVIEWS LIST -->
        <div class="row g-4">
            <% reviews.forEach(review=> { %>
                <div class="col-md-6">
                    <div class="card review-card text-white p-4">
                        <h5>
                            <%= review.movieTitle %>
                        </h5>

                        <div class="rating mb-2 text-white">
                            <%= "⭐" .repeat(review.rating) %>
                        </div>

                        <p class="text-white">
                            <%= review.comment %>
                        </p>

                        <small class="text-white">
                            By <%= review.userName %>
                        </small>
                    </div>
                </div>
                <% }) %>
        </div>

    </div>

</body>

</html>