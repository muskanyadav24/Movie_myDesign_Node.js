<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Movie</title>
    <link rel="icon" href="../../images/icon-r.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            background: #1f1f1f;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<body>

    <div class="form-card">
        <h2 class="mb-4 text-center">Add New Movie</h2>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>

                <form action="/add-movie" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Movie Title</label>
                        <input type="text" name="title" class="form-control" placeholder="Enter movie title" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Release Year</label>
                        <input type="number" name="year" class="form-control" placeholder="e.g. 2024" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="desc" class="form-control" rows="3" placeholder="Enter movie description"
                            required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Poster Image URL</label>
                        <input type="url" name="image" class="form-control" placeholder="https://example.com/poster.jpg"
                            required>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-danger btn-lg">Add Movie</button>
                        <div class="d-flex gap-2">
                            <a href="/movies" class="btn btn-outline-secondary w-50">View All</a>
                            <a href="/admin" class="btn btn-dark w-50">Admin Panel</a>
                        </div>
                    </div>
                </form>
    </div>

</body>

</html>