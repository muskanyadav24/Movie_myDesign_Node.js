<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Sign In</title>
    <link rel="icon" href="../../images/icon-r.png">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(rgba(0, 0, 0, .7), rgba(0, 0, 0, .7)),
                url("../../images/bg.jpg") no-repeat center center/cover;
            min-height: 100vh;
            color: #fff;
        }

        .logo {
            color: #e50914;
            font-size: 32px;
            font-weight: bold;
        }

        .login-box {
            background: rgba(0, 0, 0, 0.75);
            padding: 60px;
            max-width: 450px;
            margin: 80px auto;
            border-radius: 4px;
        }

        .login-box h2 {
            margin-bottom: 25px;
            font-weight: bold;
        }

        .form-control {
            background: #333;
            border: none;
            color: #fff;
            height: 50px;
        }

        .form-control::placeholder {
            color: #b3b3b3;
        }

        .btn-red {
            background: #e50914;
            color: #fff;
            font-weight: bold;
            height: 50px;
        }

        .btn-red:hover {
            background: #b91c1c;
        }

        .small-text {
            color: #b3b3b3;
            font-size: 13px;
        }

        footer {
            background: rgba(0, 0, 0, .8);
            padding: 40px;
            font-size: 14px;
        }

        footer a {
            color: #757575;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <div class="container-fluid px-5 pt-4">
        <div class="logo">RealCinema</div>
    </div>

    <!-- Login Box -->
    <div class="login-box">
        <h2>New here?</h2>
        <p>Signing up is easy. It only takes a few steps</p>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
            <% } %>

                <form action="/register" method="post">
                    <input type="hidden" name="returnTo" value="">

                    <div class="mb-3">
                        <input type="name" name="name" class="form-control" placeholder="Username" required>
                    </div>

                    <div class="mb-3">
                        <input type="email" name="email" class="form-control" placeholder="Email" required>
                    </div>

                    <div class="mb-3">
                        <input type="tel" name="phone" class="form-control" placeholder="Mobile Number" required>
                    </div>

                    <div class="mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Password" required>
                    </div>

                    <button class="btn btn-red w-100 mb-3" type="submit">Sign Up</button>
                    <p class="mt-4 small-text">
                        Already have an account?
                        <a href="/login"
                            class="text-white text-decoration-none"> Login now.</a>
                    </p>
                </form>
    </div>

    <!-- Footer -->
    <!-- <footer class="text-center text-md-start">
        <div class="container">
            <p>Questions? Call 000-800-919-1743</p>

            <div class="row">
                <div class="col-md-3"><a href="#">FAQ</a></div>
                <div class="col-md-3"><a href="#">Help Centre</a></div>
                <div class="col-md-3"><a href="#">Terms of Use</a></div>
                <div class="col-md-3"><a href="#">Privacy</a></div>
            </div>
        </div>
    </footer> -->

</body>

</html>