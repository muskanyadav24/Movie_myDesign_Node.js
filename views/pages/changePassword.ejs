<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link rel="icon" href="../../images/icon-r.png">
    <style>
        body {
            background: linear-gradient(rgba(0, 0, 0, .7), rgba(0, 0, 0, .7)),
                url("../../images/bg.jpg") no-repeat center center/cover;
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #333;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            background-color: #000;
            padding: 40px;
            border-radius: 8px;
            width: 350px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }

        h2 {
            margin-bottom: 30px;
            text-align: center;
            color: #e50914;
            /* Netflix red */
        }

        input[type="password"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: none;
            border-radius: 4px;
            background-color: #333;
            color: #fff;
        }

        input[type="password"]::placeholder {
            color: #aaa;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #e50914;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #f6121d;
        }

        .back-login {
            margin-top: 15px;
            text-align: center;
            font-size: 0.9em;
        }

        .back-login a {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- LOGO -->
    <div class="logo" style="position: absolute; top:20px; left:40px; font-size:32px; font-weight:bold; color:#e50914;">
        <a href="/" style="color:#e50914; text-decoration:none;">RealCinema</a>
    </div>


    <div class="container">
        <h2>Change Password</h2>

        <% if (typeof error !=='undefined' && error) { %>
            <div
                style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
                <%= error %>
            </div>
            <% } %>

                <% if (typeof success !=='undefined' && success) { %>
                    <div
                        style="background-color: #d4edda; color: #155724; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
                        <%= success %>
                    </div>
                    <% } %>

                        <form class="pt-3" action="/changePassword" method="post">
                            <div class="form-group">
                                <input type="password" name="currentPassword" class="form-control"
                                    placeholder="Current Password" required>
                            </div>

                            <div class="form-group">
                                <input type="password" name="newPassword" class="form-control"
                                    placeholder="New Password" required>
                            </div>

                            <div class="form-group">
                                <input type="password" name="confirmNewPassword" class="form-control"
                                    placeholder="Confirm New Password" required>
                            </div>

                            <button type="submit" class="btn btn-gradient-primary w-100">
                                Change Password
                            </button>
                        </form>
                        <div class="back-login">
                            <a href="/login">Back to Login</a>
                        </div>
    </div>

</body>

</html>