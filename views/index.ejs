<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Netflix Style Movies</title>

    <link rel="icon" href="../images/icon-r.png">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        body {
            background-color: #141414;
            color: #fff;
        }

        /* Navbar */
        .navbar {
            background-color: #000;
        }

        .navbar-brand {
            color: #e50914 !important;
            font-weight: bold;
            font-size: 28px;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(to top, #141414, transparent),
                url('https://wallpapercave.com/wp/wp4056410.jpg') center/cover;
            height: 80vh;
            display: flex;
            align-items: center;
            padding: 50px;
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: bold;
        }

        /* Movie Cards */
        .movie-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
            padding: 30px 20px 20px;
            transform: translateY(100%);
            transition: transform 0.4s ease;
        }

        .movie-card:hover .movie-overlay {
            transform: translateY(0);
        }

        .movie-card {
            border-radius: 10px;
        }

        .img-box {
            height: 500px;
            overflow: hidden;
            border-radius: 10px;
        }

        .img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .movie-card:hover img {
            transform: scale(1.1);
            filter: brightness(1.15);
        }

        .movie-title {
            margin-top: 10px;
            font-size: 16px;
            text-align: center;
        }

        /* Section Title */
        .section-title {
            margin: 40px 0 20px;
            font-weight: bold;
        }

        /* Make the container a flex row */
        .page-body-wrapper {
            display: flex;
            flex-direction: row;
        }

        .profileHover:hover{
            background-color: #1f2937;
        }

        /* Sidebar styling */
        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #212529;
            /* background-color: #2c2c2c; */
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar links */
        .sidebar .nav {
            display: flex;
            flex-direction: column;
            /* vertical list */
        }

        .sidebar .nav-item {
            width: 100%;
        }

        /* Sidebar links default */
        .sidebar .nav-link {
            color: #9ca3af;
            padding: 12px 18px;
            border-radius: 8px;
            margin: 2px 10px;
            transition: all 0.3s ease;
        }

        /* Hover effect */
        .sidebar .nav-link:hover {
            background-color: #1f2937;
            /* background-color: rgba(142, 23, 17, 0.4); */
            color: #ffffff;
        }

        /* Active link (current page) */
        .sidebar .nav-link.active {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: 600;
        }

        /* Icon color */
        .sidebar .nav-link i {
            color: inherit;
        }

        .book-btn {
            margin-top: 10px;
            width: 80%;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        /* Hover effect */
        .book-btn:hover {
            transform: scale(1.05);
            background-color: #e50914;
            box-shadow: 0 5px 15px rgba(229, 9, 20, 0.5);
        }

        /* Model */
        .netflix-modal {
            background: linear-gradient(to right, #000, #1a1a1a);
            color: #fff;
            border-radius: 12px;
            border: none;
        }

        .netflix-modal h2 {
            font-weight: 700;
        }

        .netflix-modal .meta span {
            margin-right: 10px;
            font-size: 14px;
            opacity: 0.8;
        }

        .today-title {
            position: relative;
            display: inline-block;
            padding-bottom: 12px;
        }

        .today-title::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 90px;
            height: 3px;
            background: linear-gradient(90deg, #e50914, #ff6b6b);
            border-radius: 10px;
        }

        /* Glassmorphism & Effects */
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
        }

        .movie-card {
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
            border: 1px solid transparent;
        }

        .movie-card:hover {
            transform: translateY(-12px);
            z-index: 10;
            box-shadow: 0 20px 40px rgba(229, 9, 20, 0.25);
            border-color: rgba(229, 9, 20, 0.4);
        }

        .stat-value {
            background: linear-gradient(45deg, #e50914, #ff6b6b);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }
    </style>
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark px-4">
        <a href="/home" class="navbar-brand">RealCinema</a>

        <div class="ms-auto">
            <% if (user) { %>
                <div class="dropdown">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown"
                        data-bs-toggle="dropdown">

                        <img src="../../images/face11.jpg" class="rounded-circle me-2" width="40" height="40">

                        <span class="fw-semibold text-white">
                            <%= user.name %>
                        </span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow bg-black" >
                        <li>
                            <a class="dropdown-item profileHover text-white" href="/profile">
                                👤 My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item profileHover text-white" href="/changePassword">
                                🔐 Change Password
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item profileHover text-danger" href="/logout">
                                🚪 Logout
                            </a>
                        </li>
                    </ul>
                </div>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-dark me-2">Sign In</a>
                    <a href="/register" class="btn btn-danger">Sign Up</a>
                    <% } %>
        </div>
    </nav>

    <!-- Sidebar -->
    <div class="container-fluid page-body-wrapper p-0 ">
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav pt-2">

                <!-- User Profile -->
                <li class="nav-item nav-profile">
                    <a href="#" class="nav-link d-flex align-items-center">
                        <div class="nav-profile-image">
                            <img src="../../images/face11.jpg" class="rounded-circle me-2" width="50" height="50">
                            <span class="login-status online"></span>
                        </div>
                        <div class="nav-profile-text d-flex flex-column">
                            <span class="font-weight-bold text-white">
                                <%= user.name %>
                            </span>
                            <span class="text-secondary text-small">Movie Fan</span>
                        </div>
                        <i class="mdi mdi-star-circle text-warning nav-profile-badge"></i>
                    </a>
                </li>

                <!-- Admin Panel Link -->
                <% if (user && user.role==='admin' ) { %>
                    <li class="nav-item mb-2">
                        <a class="nav-link bg-danger text-white rounded-3 shadow" href="/admin">
                            <span class="menu-title fw-bold">ADMIN DASHBOARD</span>
                            <i class="mdi mdi-shield-account menu-icon text-white"></i>
                        </a>
                    </li>
                    <hr class="border-secondary mx-3 mb-2">
                    <% } %>

                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link" href="/home">
                                <span class="menu-title">Dashboard</span>
                                <i class="mdi mdi-home menu-icon"></i>
                            </a>
                        </li>

                        <!-- Movies -->
                        <li class="nav-item">
                            <a class="nav-link" href="/movies">
                                <span class="menu-title">Movies</span>
                                <i class="mdi mdi-filmstrip menu-icon"></i>
                            </a>
                        </li>

                        <!-- Shows -->
                        <li class="nav-item">
                            <a class="nav-link" href="/shows">
                                <span class="menu-title">Shows</span>
                                <i class="mdi mdi-format-list-bulleted menu-icon"></i>
                            </a>
                        </li>

                        <!-- Theaters -->
                        <li class="nav-item">
                            <a class="nav-link" href="/theaters">
                                <span class="menu-title">Theaters</span>
                                <i class="mdi mdi-home-modern menu-icon"></i>
                            </a>
                        </li>

                        <!-- Screens -->
                        <li class="nav-item">
                            <a class="nav-link" href="/screens">
                                <span class="menu-title">Screens</span>
                                <i class="mdi mdi-monitor menu-icon"></i>
                            </a>
                        </li>

                        <!-- Tickets -->
                        <li class="nav-item">
                            <a class="nav-link" href="/my-bookings">
                                <span class="menu-title">My Tickets</span>
                                <i class="mdi mdi-ticket menu-icon"></i>
                            </a>
                        </li>

                        <!-- Reviews -->
                        <li class="nav-item">
                            <a class="nav-link" href="/reviews">
                                <span class="menu-title">Reviews</span>
                                <i class="mdi mdi-comment-text menu-icon"></i>
                            </a>
                        </li>

                        <!-- Profile -->
                        <li class="nav-item">
                            <a class="nav-link" href="/profile">
                                <span class="menu-title">Profile</span>
                                <i class="mdi mdi-account menu-icon"></i>
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">
                                <span class="text-danger">Logout</span>
                                <i class="mdi mdi-logout menu-icon"></i>
                            </a>
                        </li>

            </ul>

        </nav>
        <!-- New Releases Section -->

        <div class="container-fluid px-4 mt-4">
            <!-- Stats cards restored -->
            <div class="row g-4 mt-2">
                <div class="col-md-3">
                    <div class="card glass-card text-white shadow rounded-4 p-3 border-0">
                        <h6 class="text-secondary small text-uppercase fw-bold">Total Movies</h6>
                        <h2 class="stat-value mb-0">
                            <%= totalMovies %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card glass-card text-white shadow rounded-4 p-3 border-0">
                        <h6 class="text-secondary small text-uppercase fw-bold">Total Shows</h6>
                        <h2 class="stat-value mb-0">
                            <%= totalShows %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card glass-card text-white shadow rounded-4 p-3 border-0">
                        <h6 class="text-secondary small text-uppercase fw-bold">Tickets Sold</h6>
                        <h2 class="stat-value mb-0">
                            <%= totalTickets %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card glass-card text-white shadow rounded-4 p-3 border-0">
                        <h6 class="text-secondary small text-uppercase fw-bold">Customers</h6>
                        <h2 class="stat-value mb-0">
                            <%= totalCustomers %>
                        </h2>
                    </div>
                </div>
            </div>

            <div class="container-fluid px-4 mt-4 pb-5">
                <h3 class="section-title today-title">New Releases</h3>

                <div class="row g-3 pb-5">

                    <% movies.forEach(movie=> { %>

                        <div class="col-3 col-md-3 movie-card pb-5">
                            <div class="img-box">
                                <img src="<%= movie.image %>" class="img-fluid">
                            </div>

                            <p class="movie-title">
                                <%= movie.title %>
                            </p>

                            <div class="text-center">
                                <a class="btn btn-danger book-btn" data-bs-toggle="modal" data-bs-target="#movieModal"
                                    data-image="<%= movie.image %>" data-id="<%= movie._id %>"
                                    data-title="<%= movie.title %>" data-year="<%= movie.year %>"
                                    data-desc="<%= movie.desc %>" data-price="<%= movie.price %>">
                                    🎟 Book Tickets
                                </a>
                            </div>
                        </div>

                        <% }) %>

                </div>

                <h3 class="section-title today-title">🎬 Today Shows</h3>

                <div class="row g-3 pb-5">
                    <% shows.forEach(show=> { %>
                        <div class="col-md-6">
                            <div class="card bg-dark text-white rounded-4 shadow p-4 show-card">

                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">
                                            <%= show.movieId ? show.movieId.title : 'Unknown' %>
                                        </h5>
                                        <small class="text-secondary">
                                            🎥 <%= show.theaterId ? show.theaterId.name : 'Unknown' %> • Screen <%=
                                                    show.screenId ? show.screenId.name : 'Unknown' %>
                                        </small>
                                    </div>

                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        <%= new Date(show.showTime).toLocaleTimeString([], { hour: '2-digit' ,
                                            minute: '2-digit' }) %>
                                    </span>
                                </div>

                                <div class="mt-3 d-flex justify-content-between align-items-center">
                                    <span class="text-success fw-semibold">
                                        🪑 <%= show.seats %> Seats Available
                                    </span>

                                    <a href="/booking/<%= show._id %>"
                                        class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Book Now
                                    </a>
                                </div>

                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </div>
    </div>

    <!-- Movie Modal -->
    <div class="modal fade" id="movieModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content netflix-modal">

                <button type="button" class="btn-close btn-close-white ms-auto m-3" data-bs-dismiss="modal"></button>

                <div class="modal-body d-flex gap-4">
                    <!-- Poster -->
                    <img id="modalPoster" class="rounded" style="width: 150px">
                    <!-- Info -->
                    <div class="d-flex align-items-center flex-column">
                        <h2 id="modalTitle"></h2>

                        <div class="meta">
                            <span id="modalYear"></span>
                            <span class="badge bg-secondary">UA 16+</span>
                            <span class="badge bg-secondary">Sci-Fi</span>
                        </div>
                        <p id="modalPrice" class="mt-3"></p>
                        <p id="modalDesc" class="mt-2 text-white text-center"></p>
                        <a id="getStartedBtn" href="pages/booking.ejs" class="btn btn-danger mt-3">
                            Get Started →
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        document.querySelectorAll('.book-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modalTitle').innerText = btn.dataset.title;
                document.getElementById('modalYear').innerText = btn.dataset.year;
                document.getElementById('modalDesc').innerText = btn.dataset.desc;
                document.getElementById('modalPoster').src = btn.dataset.image;
                document.getElementById('modalPrice').innerText = btn.dataset.price;
                const getStartedBtn = document.getElementById('getStartedBtn');

                // dynamic booking URL
                document.getElementById('getStartedBtn').href =
                    `/booking/${btn.dataset.id}`;

            });
        });

        // Modal Redirect Fix
        document.getElementById('getStartedBtn').addEventListener('click', function (e) {
            e.preventDefault();
            const url = this.href; // 'this' refers to the correct <a> element

            const modalElement = document.getElementById('movieModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();

            setTimeout(() => {
                window.location.href = url;
            }, 300);
        });

    </script>


</body>

</html>